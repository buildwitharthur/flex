# Server-side API origin used by Astro SSR (partners catalog), without a trailing slash.
API_URL=http://localhost:3333
# Set the official production origin, without a trailing slash.
SITE_URL=

# Public API origin used by the browser (Flex assistant), without a trailing slash.
# The API must list the landing origin in CORS_ORIGINS.
PUBLIC_API_URL=http://localhost:3333
