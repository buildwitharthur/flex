---
import Button from './ui/button.astro'
---

<header class="absolute inset-x-0 top-0 z-20">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10"
  >
    <a href="/" class="flex items-baseline gap-1" aria-label="Parceiros">
      <span class="display text-2xl text-ink">Parceiros</span>
      <span class="display-italic text-2xl text-coral">+</span>
    </a>

    <div class="hidden items-center gap-10 text-sm md:flex">
      <a href="#parceiros" class="text-ink/70 transition-colors hover:text-ink">
        Parceiros
      </a>
      <a href="#beneficios" class="text-ink/70 transition-colors hover:text-ink">
        Benefícios
      </a>
      <a
        href="#como-funciona"
        class="text-ink/70 transition-colors hover:text-ink"
      >
        Como funciona
      </a>
    </div>

    <Button
      type="button"
      data-open-flex-partner
      size="sm"
      class="whitespace-nowrap"
    >
      Quero ser Parceiro
    </Button>
  </nav>
</header>
