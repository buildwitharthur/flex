---
import { MessageCircleMore, X } from 'lucide-astro'
---

<div data-flex-bot>
  <button
    type="button"
    data-flex-bot-trigger
    aria-label="Abrir atendimento"
    class="fixed right-4 bottom-4 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-ink text-cream-50 transition-colors hover:bg-coral sm:right-6 sm:bottom-6"
  >
    <MessageCircleMore size={24} strokeWidth={1.8} aria-hidden="true" />
  </button>

  <section
    data-flex-bot-panel
    role="dialog"
    aria-label="Atendimento Flex"
    tabindex="-1"
    hidden
    class="fixed right-4 bottom-20 z-50 flex h-[560px] max-h-[calc(100dvh-6rem)] w-[calc(100vw-2rem)] max-w-[380px] flex-col overflow-hidden rounded-2xl border border-ink/10 bg-cream-50 text-ink opacity-0 shadow-xl transition-all duration-200 sm:right-6 sm:bottom-24 sm:max-h-[calc(100dvh-7rem)]"
  >
    <header class="flex shrink-0 items-center justify-between border-b border-ink/10 bg-cream-100 px-5 py-4 [@media(max-height:480px)]:py-2">
      <div>
        <p class="display text-xl">Flex</p>
        <div class="mt-1 flex items-center gap-2 text-xs text-ink/60">
          <span class="h-2 w-2 rounded-full bg-forest" aria-hidden="true"></span>
          <span>Assistente virtual</span>
        </div>
      </div>

      <button
        type="button"
        data-flex-bot-close
        aria-label="Fechar atendimento"
        class="inline-flex h-8 w-8 items-center justify-center rounded-full text-xl leading-none text-ink/60 transition-colors hover:bg-ink/10 hover:text-ink"
      >
        <X size={20} strokeWidth={2} aria-hidden="true" />
      </button>
    </header>

    <div
      data-flex-bot-messages
      role="log"
      aria-live="polite"
      aria-relevant="additions"
      class="min-h-0 flex-1 overflow-y-auto p-4 [@media(max-height:480px)]:p-2"
    ></div>

    <div
      data-flex-bot-controls
      class="shrink-0 border-t border-ink/10 bg-cream-50 p-4 [@media(max-height:480px)]:p-2"
    ></div>
  </section>
</div>

<script>
  const root = document.querySelector('[data-flex-bot]')

  if (root && root.dataset.initialized !== 'true') {
    root.dataset.initialized = 'true'

    const floatingTrigger = root.querySelector('[data-flex-bot-trigger]')
    const panel = root.querySelector('[data-flex-bot-panel]')
    const closeButton = root.querySelector('[data-flex-bot-close]')
    const messages = root.querySelector('[data-flex-bot-messages]')
    const controls = root.querySelector('[data-flex-bot-controls]')

    if (
      floatingTrigger instanceof HTMLButtonElement &&
      panel instanceof HTMLElement &&
      closeButton instanceof HTMLButtonElement &&
      messages instanceof HTMLElement &&
      controls instanceof HTMLElement
    ) {
      const typingDelay = 560
      const whatsappUrl = 'https://wa.me/552127029080'
      type LeadType = 'PARTNER' | 'MEMBER'
      type QuickReply = {
        label: string
        action: () => void | Promise<void>
        variant?: 'primary' | 'accent' | 'secondary'
      }

      let state = 'WELCOME'
      let flowId = 0
      let submitInFlight = false
      let lastTrigger = floatingTrigger
      let lead = createEmptyLead()

      function createEmptyLead(type: LeadType = 'PARTNER') {
        return {
          type,
          name: '',
          company: '',
          phone: '',
          email: '',
        }
      }

      function prefersReducedMotion() {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches
      }

      function wait(milliseconds) {
        return new Promise((resolve) => window.setTimeout(resolve, milliseconds))
      }

      function scrollToBottom() {
        messages.scrollTo({
          top: messages.scrollHeight,
          behavior: prefersReducedMotion() ? 'auto' : 'smooth',
        })
      }

      function addMessage(text, role) {
        const row = document.createElement('div')
        row.className = `mb-3 flex ${role === 'user' ? 'justify-end' : 'justify-start'}`

        const bubble = document.createElement('div')
        bubble.className =
          role === 'user'
            ? 'max-w-[88%] whitespace-pre-line rounded-2xl rounded-br-sm bg-ink px-4 py-3 text-sm leading-relaxed text-cream-50'
            : 'max-w-[88%] whitespace-pre-line rounded-2xl rounded-bl-sm bg-cream-100 px-4 py-3 text-sm leading-relaxed text-ink'
        bubble.textContent = text

        row.append(bubble)
        messages.append(row)
        scrollToBottom()
      }

      function addBotMessage(text) {
        addMessage(text, 'bot')
      }

      function addUserMessage(text) {
        addMessage(text, 'user')
      }

      function showTyping() {
        hideTyping()

        const typing = document.createElement('div')
        typing.dataset.flexBotTyping = 'true'
        typing.setAttribute('role', 'status')
        typing.setAttribute('aria-label', 'Flex está digitando')
        typing.className = 'mb-3 flex justify-start'
        typing.innerHTML = `
          <div class="flex items-center gap-1 rounded-2xl rounded-bl-sm bg-cream-100 px-4 py-3 text-ink/60">
            <span class="sr-only">Flex está digitando</span>
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-ink/50"></span>
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-ink/50 [animation-delay:120ms]"></span>
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-ink/50 [animation-delay:240ms]"></span>
          </div>
        `
        messages.append(typing)
        scrollToBottom()
      }

      function hideTyping() {
        messages.querySelector('[data-flex-bot-typing]')?.remove()
      }

      function clearControls() {
        controls.replaceChildren()
      }

      function resetConversation() {
        flowId += 1
        state = 'WELCOME'
        lead = createEmptyLead()
        hideTyping()
        messages.replaceChildren()
        clearControls()
      }

      function showPanel() {
        panel.hidden = false
        panel.classList.remove('opacity-0', 'translate-y-2', 'scale-[0.98]')
        floatingTrigger.setAttribute('aria-label', 'Fechar atendimento')
        panel.focus()
      }

      function closeBot() {
        const triggerToRestore = lastTrigger
        panel.hidden = true
        panel.classList.add('opacity-0')
        floatingTrigger.setAttribute('aria-label', 'Abrir atendimento')
        resetConversation()

        if (triggerToRestore instanceof HTMLElement) {
          triggerToRestore.focus()
        }
      }

      async function say(text, currentFlow = flowId) {
        showTyping()
        await wait(typingDelay)

        if (currentFlow !== flowId) return false
        if (panel.hidden) {
          hideTyping()
          return false
        }

        hideTyping()
        addBotMessage(text)
        return true
      }

      function openExternal(url) {
        window.open(url, '_blank', 'noopener,noreferrer')
      }

      function renderQuickReplies(items: QuickReply[], note = '') {
        clearControls()

        if (note) {
          const noteElement = document.createElement('p')
          noteElement.className = 'mb-3 text-xs leading-relaxed text-ink/50'
          noteElement.textContent = note
          controls.append(noteElement)
        }

        const list = document.createElement('div')
        list.className = 'flex flex-col gap-2 [@media(max-height:480px)]:gap-1'

        const variants = {
          primary: 'border-transparent bg-ink font-medium text-cream-50 hover:bg-coral',
          accent: 'border-transparent bg-forest font-medium text-cream-50 hover:bg-forest-dark',
          secondary: 'border-ink/15 bg-transparent text-ink hover:bg-ink/5',
        }

        items.forEach((item) => {
          const button = document.createElement('button')
          button.type = 'button'
          button.className = `w-full rounded-full border px-4 py-3 text-left text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-50 [@media(max-height:480px)]:py-1.5 ${variants[item.variant ?? 'secondary']}`
          button.textContent = item.label
          button.addEventListener('click', async () => {
            if (button.disabled) return

            list.querySelectorAll('button').forEach((reply) => {
              reply.disabled = true
            })
            clearControls()
            addUserMessage(item.label)
            const currentFlow = flowId
            await item.action()
            if (currentFlow === flowId && !panel.hidden && !controls.childElementCount) {
              renderQuickReplies(items, note)
            }
          })
          list.append(button)
        })

        controls.append(list)
        scrollToBottom()
      }

      function setInputError(form, message) {
        let error = form.querySelector('[data-field-error]')

        if (!(error instanceof HTMLElement)) {
          error = document.createElement('p')
          error.dataset.fieldError = 'true'
          error.className = 'mt-2 text-xs text-coral-dark'
          const input = form.querySelector('input')
          input.after(error)
        }

        error.textContent = message
      }

      function renderInput({
        stateForInput,
        type,
        autocomplete,
        placeholder,
        optional = false,
      }) {
        clearControls()

        const form = document.createElement('form')
        form.className = 'flex flex-col gap-2'

        const label = document.createElement('label')
        label.className = 'sr-only'
        label.htmlFor = `flex-bot-${stateForInput.toLowerCase()}`
        label.textContent = placeholder

        const input = document.createElement('input')
        input.id = label.htmlFor
        input.name = stateForInput.toLowerCase()
        input.type = type
        input.autocomplete = autocomplete
        input.placeholder = placeholder
        input.required = !optional
        input.className =
          'w-full min-w-0 rounded-full border border-ink/15 bg-cream-50 px-4 py-3 text-sm text-ink outline-none placeholder:text-ink/40 focus:border-forest disabled:cursor-not-allowed disabled:opacity-50'

        const submit = document.createElement('button')
        submit.type = 'submit'
        submit.className =
          'w-full rounded-full bg-ink px-4 py-3 text-sm font-medium text-cream-50 transition-colors hover:bg-coral disabled:cursor-not-allowed disabled:opacity-50'
        submit.textContent = 'Continuar'

        form.append(label, input, submit)

        if (optional) {
          const skip = document.createElement('button')
          skip.type = 'button'
          skip.className =
            'self-start px-2 py-1 text-xs text-ink/60 transition-colors hover:text-coral'
          skip.textContent = 'Pular'
          skip.addEventListener('click', async () => {
            addUserMessage('Pular')
            clearControls()
            lead.email = ''
            await showLeadConfirmation()
          })
          form.append(skip)
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault()
          if (submit.disabled) return

          const value = input.value.trim()
          const error = validateInput(stateForInput, value)

          if (error) {
            setInputError(form, error)
            input.focus()
            return
          }

          submit.disabled = true
          input.disabled = true
          addUserMessage(value)
          clearControls()
          await continueLeadFlow(stateForInput, value)
        })

        controls.append(form)
        requestAnimationFrame(() => input.focus())
        scrollToBottom()
      }

      function validateInput(inputState, value) {
        if (!value) return 'Preencha este campo para continuar.'

        if (inputState === 'PARTNER_PHONE' || inputState === 'MEMBER_PHONE') {
          const digits = value.replace(/\D/g, '')
          if (digits.length < 10 || digits.length > 13) {
            return 'Informe um telefone válido.'
          }
        }

        if (inputState === 'PARTNER_EMAIL' || inputState === 'MEMBER_EMAIL') {
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
            return 'Informe um e-mail válido ou escolha Pular.'
          }
        }

        return ''
      }

      async function startWelcomeFlow() {
        resetConversation()
        showPanel()
        const currentFlow = flowId
        state = 'INTENT'

        if (!(await say('Oi! 👋', currentFlow))) return
        if (
          !(await say(
            'Quer fazer parte do Flex ou cadastrar sua empresa como parceira?',
            currentFlow,
          ))
        ) {
          return
        }

        renderQuickReplies([
          { label: 'Quero ser parceiro', action: startPartnerFlow, variant: 'primary' },
          { label: 'Quero ser Flex', action: startMemberFlow, variant: 'accent' },
          { label: 'Conhecer os benefícios', action: startBenefitsFlow },
          { label: 'Tenho outra dúvida', action: startOtherFlow },
        ])
      }

      function startPartnerFlow() {
        return startLeadFlow('PARTNER')
      }

      function startMemberFlow() {
        return startLeadFlow('MEMBER')
      }

      async function startLeadFlow(type: LeadType) {
        clearControls()
        lead = createEmptyLead(type)
        state = `${type}_NAME`
        const currentFlow = ++flowId

        if (
          !(await say(
            'Ótimo! Vou pegar algumas informações para nossa equipe falar com você.',
            currentFlow,
          ))
        ) {
          return
        }

        if (!(await say('Como posso te chamar?', currentFlow))) return
        renderInput({
          stateForInput: state,
          type: 'text',
          autocomplete: 'name',
          placeholder: 'Seu nome',
        })
      }

      async function continueLeadFlow(inputState, value) {
        if (inputState === 'PARTNER_NAME') {
          lead.name = value
          state = 'PARTNER_COMPANY'
          const currentFlow = ++flowId
          if (!(await say(`Prazer, ${lead.name}! Qual é o nome da empresa que você representa?`, currentFlow))) return
          renderInput({
            stateForInput: 'PARTNER_COMPANY',
            type: 'text',
            autocomplete: 'organization',
            placeholder: 'Nome da empresa',
          })
          return
        }

        if (inputState === 'PARTNER_COMPANY' || inputState === 'MEMBER_NAME') {
          if (inputState === 'PARTNER_COMPANY') lead.company = value
          else lead.name = value
          state = `${lead.type}_PHONE`
          const currentFlow = ++flowId
          if (!(await say('Perfeito. Qual número podemos usar para falar com você pelo WhatsApp?', currentFlow))) return
          renderInput({
            stateForInput: state,
            type: 'tel',
            autocomplete: 'tel',
            placeholder: '(21) 99999-9999',
          })
          return
        }

        if (inputState === 'PARTNER_PHONE' || inputState === 'MEMBER_PHONE') {
          lead.phone = value.replace(/\D/g, '')
          state = `${lead.type}_EMAIL`
          const currentFlow = ++flowId
          if (!(await say('Se quiser, também pode deixar seu e-mail.', currentFlow))) return
          renderInput({
            stateForInput: state,
            type: 'email',
            autocomplete: 'email',
            placeholder: 'Seu e-mail (opcional)',
            optional: true,
          })
          return
        }

        if (inputState === 'PARTNER_EMAIL' || inputState === 'MEMBER_EMAIL') {
          lead.email = value
          await showLeadConfirmation()
        }
      }

      async function showLeadConfirmation() {
        state = `${lead.type}_CONFIRM`
        const currentFlow = ++flowId
        if (!(await say('Só para confirmar:', currentFlow))) return

        const summary = [
          `Nome: ${lead.name}`,
          ...(lead.type === 'PARTNER' ? [`Empresa: ${lead.company}`] : []),
          `WhatsApp: ${formatPhone(lead.phone)}`,
          ...(lead.email ? [`E-mail: ${lead.email}`] : []),
        ].join('\n')
        addBotMessage(summary)

        renderQuickReplies(
          [
            { label: 'Enviar contato', action: submitLead, variant: 'primary' },
            { label: 'Começar novamente', action: startWelcomeFlow },
          ],
          'Ao enviar, seus dados serão usados pela equipe Flex para entrar em contato com você.',
        )
      }

      function formatPhone(phone) {
        if (phone.length === 11) {
          return `(${phone.slice(0, 2)}) ${phone.slice(2, 7)}-${phone.slice(7)}`
        }
        if (phone.length === 10) {
          return `(${phone.slice(0, 2)}) ${phone.slice(2, 6)}-${phone.slice(6)}`
        }
        return phone
      }

      async function submitLead() {
        if (submitInFlight) return
        submitInFlight = true
        state = `${lead.type}_SUBMIT`
        const currentFlow = ++flowId
        showTyping()

        try {
          const payload = {
            type: lead.type,
            name: lead.name,
            ...(lead.type === 'PARTNER' ? { company: lead.company } : {}),
            phone: lead.phone,
            ...(lead.email ? { email: lead.email } : {}),
          }
          const response = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
          const result = await response.json().catch(() => ({ success: false }))

          if (!response.ok || result.success !== true) {
            throw new Error('lead-submit-failed')
          }

          if (currentFlow !== flowId || panel.hidden) return
          hideTyping()
          state = `${lead.type}_SUCCESS`
          if (!(await say(`Pronto, ${lead.name}! Recebi seus dados. ✅`, currentFlow))) return
          if (!(await say('Nossa equipe vai entrar em contato com você pelo WhatsApp informado.', currentFlow))) return
          renderQuickReplies([
            { label: 'Fechar atendimento', action: closeBot },
            { label: 'Conhecer os benefícios', action: startBenefitsFlow },
          ])
        } catch {
          if (currentFlow !== flowId || panel.hidden) return
          hideTyping()
          state = `${lead.type}_ERROR`
          if (!(await say('Não consegui enviar seus dados agora.', currentFlow))) return
          if (!(await say('Você pode tentar novamente ou falar com a gente pelo WhatsApp.', currentFlow))) return
          renderQuickReplies([
            { label: 'Tentar novamente', action: submitLead, variant: 'primary' },
            { label: 'Abrir WhatsApp', action: () => openExternal(whatsappUrl) },
          ])
        } finally {
          submitInFlight = false
        }
      }

      async function startBenefitsFlow() {
        state = 'BENEFITS'
        const currentFlow = ++flowId
        if (
          !(await say(
            'Com o Flex você tem acesso a descontos em saúde, educação, lazer, beleza e vários outros serviços.',
            currentFlow,
          ))
        ) {
          return
        }

        renderQuickReplies([
          { label: 'Como funciona', action: showHowItWorks },
          { label: 'Ver benefícios', action: showBenefits },
          { label: 'Quero ser parceiro', action: startPartnerFlow, variant: 'primary' },
          { label: 'Quero ser Flex', action: startMemberFlow, variant: 'accent' },
        ])
      }

      async function showHowItWorks() {
        state = 'BENEFITS'
        const currentFlow = ++flowId
        if (
          !(await say(
            'É simples: você faz sua adesão, encontra os parceiros disponíveis e apresenta sua carteirinha digital junto com um documento de identificação para usar os descontos.',
            currentFlow,
          ))
        ) {
          return
        }

        renderQuickReplies([
          {
            label: 'Ver como funciona na página',
            action: () => {
              closeBot()
              window.location.hash = 'como-funciona'
            },
          },
          { label: 'Quero ser Flex', action: startMemberFlow, variant: 'accent' },
          { label: 'Voltar', action: startBenefitsFlow },
        ])
      }

      async function showBenefits() {
        state = 'BENEFITS'
        const currentFlow = ++flowId
        if (
          !(await say(
            'Temos parceiros em várias categorias, como consultas, exames, laboratório, drogaria, terapias, odontologia, lazer, cursos e muito mais.',
            currentFlow,
          ))
        ) {
          return
        }

        renderQuickReplies([
          { label: 'Quero ser Flex', action: startMemberFlow, variant: 'accent' },
          { label: 'Quero ser parceiro', action: startPartnerFlow, variant: 'primary' },
          { label: 'Voltar', action: startBenefitsFlow },
        ])
      }

      async function startOtherFlow() {
        state = 'OTHER'
        const currentFlow = ++flowId
        if (
          !(await say(
            'Sem problema. Você pode falar diretamente com nossa equipe pelo WhatsApp ou voltar ao início.',
            currentFlow,
          ))
        ) {
          return
        }

        renderQuickReplies([
          { label: 'Abrir WhatsApp', action: () => openExternal(whatsappUrl) },
          { label: 'Voltar', action: startWelcomeFlow },
        ])
      }

      floatingTrigger.addEventListener('click', () => {
        if (!panel.hidden) {
          closeBot()
          return
        }

        lastTrigger = floatingTrigger
        startWelcomeFlow()
      })

      closeButton.addEventListener('click', closeBot)

      document.querySelectorAll('[data-partner-lead-trigger]').forEach((trigger) => {
        if (trigger === floatingTrigger) return

        trigger.addEventListener('click', (event) => {
          event.preventDefault()
          lastTrigger = trigger
          if (panel.hidden) showPanel()
          startPartnerFlow()
        })
      })

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.hidden) {
          closeBot()
        }
      })
    }
  }
</script>
