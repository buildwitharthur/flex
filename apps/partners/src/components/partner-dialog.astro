---
import { X } from 'lucide-astro'
import Dialog from './ui/dialog.astro'
---

<Dialog
  id="partner-dialog"
  aria-labelledby="partner-dialog-title"
  class="w-[672px] rounded-3xl bg-cream-50 text-ink backdrop:bg-ink/60"
>
  <div data-partner-dialog-content class="relative p-6 sm:p-10">
    <form method="dialog" class="absolute right-5 top-5">
      <button
        type="submit"
        aria-label="Fechar"
        autofocus
        class="flex h-9 w-9 items-center justify-center rounded-full bg-ink/5 text-ink transition-colors hover:bg-ink/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest"
      >
        <X size={14} strokeWidth={1.5} aria-hidden="true" />
      </button>
    </form>

    <p
      data-partner-dialog-category
      class="mb-5 pr-10 text-xs uppercase leading-4 tracking-[0.1em] text-ink/40"
    ></p>
    <h2
      id="partner-dialog-title"
      data-partner-dialog-name
      class="display break-words pr-5 text-3xl leading-[1.1] sm:text-4xl"
    ></h2>
    <p
      data-partner-dialog-discount
      class="display-italic mt-1 break-words text-3xl leading-9 text-coral"
    ></p>

    <div data-partner-dialog-description-block class="mt-6 text-base leading-[26px] text-ink/70">
      <p data-partner-dialog-description-label hidden class="mb-7"></p>
      <p data-partner-dialog-description class="whitespace-pre-line break-words"></p>
    </div>
  </div>
</Dialog>

<script>
  import { setupPartnerDialog } from '../scripts/partner-dialog'

  setupPartnerDialog()
</script>
