---
import type { HTMLAttributes } from 'astro/types'
import { twMerge } from 'tailwind-merge'

type Props = HTMLAttributes<'input'> & {
  variant?: 'default' | 'search'
}

const { variant = 'default', class: className, ...props } = Astro.props

const variants = {
  default: 'rounded-full border border-ink/15 bg-transparent px-4 py-2.5 text-sm outline-none placeholder:text-ink/40 focus:border-forest',
  search: 'w-full rounded-full border border-ink/10 bg-cream-50 py-4 px-5 text-base placeholder:text-ink/40 transition-colors focus:border-forest focus:outline-none focus:ring-2 focus:ring-forest/15',
}
---

<input
  {...props}
  class={twMerge('text-ink', variants[variant], className)}
/>
