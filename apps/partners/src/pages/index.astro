---
import BaseLayout from '../layouts/base-layout.astro'
import Header from '../components/header.astro'
import Hero from '../components/hero.astro'
import ServicesTicker from '../components/services-ticker.astro'
import Benefits from '../components/benefits.astro'
import PartnersSection from '../components/partners-section.astro'
import HowItWorks from '../components/how-it-works.astro'
import Footer from '../components/footer.astro'
import FlexBot from '../components/flex-bot/flex-bot'
---

<BaseLayout
  title="Clube Flex"
  description="Benefícios e parceiros para aproveitar mais todos os dias."
>
  <main class="grain-bg bg-cream-50 text-ink">
    <Header />
    <Hero />
    <ServicesTicker />
    <Benefits />
    <PartnersSection />
    <HowItWorks />
    <Footer />
  </main>
  <FlexBot client:load />
</BaseLayout>
