---
import BaseLayout from '../layouts/base-layout.astro'
import Header from '../components/header.astro'
import Hero from '../components/hero.astro'
import ServicesTicker from '../components/services-ticker.astro'
import Benefits from '../components/benefits.astro'
import PartnersSection from '../components/partners-section.astro'
import HowItWorks from '../components/how-it-works.astro'
import Footer from '../components/footer.astro'
import FlexBot from '../components/flex-bot.astro'
import type { PartnerSort, PublicPartner } from '../types/partner'

const PAGE_SIZE = 12
const searchParams = Astro.url.searchParams

function normalizeSearchValue(value: unknown) {
  return String(value ?? '')
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLocaleLowerCase('pt-BR')
    .trim()
}

function parsePage(value: string | null) {
  const page = Number(value)
  return Number.isInteger(page) && page >= 1 ? page : 1
}

function parseDiscount(value: string) {
  const match = value.match(/\d+/)
  return match ? Number(match[0]) : 0
}

let partners: PublicPartner[] = []
let partnersError = false

try {
  const apiUrl = import.meta.env.API_URL

  if (!apiUrl) {
    throw new Error('API_URL is not configured')
  }

  const response = await fetch(`${apiUrl.replace(/\/$/, '')}/partners/public`)

  if (!response.ok) {
    throw new Error(`Public partners request failed with ${response.status}`)
  }

  const data: unknown = await response.json()

  if (
    typeof data !== 'object' ||
    data === null ||
    !('partners' in data) ||
    !Array.isArray(data.partners)
  ) {
    throw new Error('Invalid public partners response')
  }

  partners = data.partners as PublicPartner[]
} catch (error) {
  partnersError = true
  console.error('Could not load public partners', error)
}

const query = searchParams.get('q')?.trim() ?? ''
const normalizedQuery = normalizeSearchValue(query)
const requestedCategory = searchParams.get('category')?.trim() ?? 'all'
const rawSort = searchParams.get('sort')?.trim()
const sort: PartnerSort = rawSort === 'name' || rawSort === 'discount'
  ? rawSort
  : 'featured'

const categories = Array.from(
  partners.reduce((categoryMap, partner) => {
    const key = partner.category.id
    const existing = categoryMap.get(key)

    categoryMap.set(key, {
      key,
      name: partner.category.name,
      count: (existing?.count ?? 0) + 1,
    })

    return categoryMap
  }, new Map<string, { key: string; name: string; count: number }>()),
).map(([, category]) => category)

const activeCategory = requestedCategory === 'all' ||
  categories.some((category) => category.key === requestedCategory)
  ? requestedCategory
  : 'all'

const searchedPartners = normalizedQuery
  ? partners.filter((partner) => {
      const searchableText = [
        partner.name,
        partner.description,
        partner.discount,
        partner.category.name,
      ]
        .map(normalizeSearchValue)
        .join(' ')

      return searchableText.includes(normalizedQuery)
    })
  : partners

const filteredPartners = searchedPartners
  .filter((partner) => activeCategory === 'all' || partner.category.id === activeCategory)
  .sort((a, b) => {
    if (sort === 'name') {
      return a.name.localeCompare(b.name, 'pt-BR')
    }

    if (sort === 'discount') {
      return parseDiscount(b.discount) - parseDiscount(a.discount) ||
        a.name.localeCompare(b.name, 'pt-BR')
    }

    if (a.isFeatured !== b.isFeatured) {
      return Number(b.isFeatured) - Number(a.isFeatured)
    }

    return a.name.localeCompare(b.name, 'pt-BR')
  })

const filteredCount = filteredPartners.length
const totalPages = Math.max(1, Math.ceil(filteredCount / PAGE_SIZE))
const requestedPage = parsePage(searchParams.get('page'))
const page = Math.min(requestedPage, totalPages)
const start = (page - 1) * PAGE_SIZE
const paginatedPartners = filteredPartners.slice(start, start + PAGE_SIZE)
---

<BaseLayout
  title="Flex Clube"
  description="Benefícios e parceiros para aproveitar mais todos os dias."
>
  <main class="grain-bg bg-cream-50 text-ink">
    <Header />
    <Hero />
    <ServicesTicker />
    <Benefits />
    <PartnersSection
      partners={paginatedPartners}
      categories={categories}
      totalPartners={partners.length}
      filteredCount={filteredCount}
      page={page}
      totalPages={totalPages}
      query={query}
      activeCategory={activeCategory}
      sort={sort}
      error={partnersError}
    />
    <HowItWorks />
    <Footer />
  </main>
  <FlexBot />
</BaseLayout>
