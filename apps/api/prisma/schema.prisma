generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  isActive     Boolean  @default(true)
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

enum ContactSource {
  WEBSITE
  MANUAL
}

enum ContactStage {
  NEW
  CONTACTED
  NEGOTIATION
  COMPLETED
  LOST
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String        @unique
  source    ContactSource  
  stage     ContactStage  @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([source])
  @@index([stage])
  @@index([createdAt])
  @@map("contacts")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  partners  Partner[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Partner {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  description            String   @db.Text
  shortDescription       String?
  discount               String
  address                String?
  phone                  String?
  whatsapp               String?
  logoUrl                String?
  websiteUrl             String?
  couponCode             String?
  redemptionInstructions String?  @db.Text
  isActive               Boolean  @default(true)
  isFeatured             Boolean  @default(false)
  categoryId             String
  category               Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@map("partners")
}
